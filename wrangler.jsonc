// Salix op Cloudflare Workers: statische site (site/dist) + API-worker (/api/*).
// Workers Builds: root directory leeg, build command leeg,
// deploy command: npx wrangler d1 migrations apply DB --remote && npx wrangler deploy
// Setup en hoe je aanvragen bekijkt: docs/setup-api.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salix",
  "main": "site/workers/api/src/index.ts",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "node site/build/build.mjs"
  },
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salix",
      "database_id": "92753aa2-dcbf-4ae9-a766-884c405a6956",
      "migrations_dir": "site/workers/api/migrations"
    }
  ],
  // Foto's van het voorbeeldformulier. Bucket eenmalig aanmaken in het dashboard (R2 → Create bucket → salix-fotos).
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "salix-fotos" }
  ],
  // Meldingen via Resend. RESEND_API_KEY is een geheim (dashboard → salix → Settings → Variables and Secrets),
  // nooit in deze repo. Zonder sleutel worden er geen mails verstuurd; aanvragen worden altijd bewaard in D1.
  // MAIL_FROM moet op een domein staan dat in Resend geverifieerd is.
  "vars": {
    "MAIL_FROM": "Salix website <salix@naitvision.be>",
    "MAIL_TO": "info@naitvision.be"
  },
  // Max. 5 formulieren per minuut per IP
  "ratelimits": [
    { "name": "RL", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Eigen domein (Custom Domain op de zone naitvision.be)
  "routes": [{ "pattern": "salix.naitvision.be", "custom_domain": true }],
  "observability": { "enabled": true }
}
