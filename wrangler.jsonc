// Salix-site op Cloudflare Workers (static assets), vanuit de root van de repo.
// "wrangler deploy" draait eerst de build (build.command) en publiceert dan site/dist.
// Cloudflare Workers Builds: root directory leeg, build command leeg, deploy command "npx wrangler deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salix",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "node site/build/build.mjs"
  },
  "assets": {
    "directory": "./site/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
