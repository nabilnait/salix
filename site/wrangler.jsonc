// Salix-site op Cloudflare Workers (static assets).
// Cloudflare Workers Builds: root directory "site", build "node build/build.mjs", deploy "npx wrangler deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salix",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "node build/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
